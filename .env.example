# Copy to .env and fill in. .env is gitignored; this file is the template and holds no real values.

# ── Google PageSpeed Insights / Chrome UX Report ─────────────────────────────
# Enables C-4.1 Core Web Vitals. One key serves both APIs; enable "PageSpeed Insights API" and
# "Chrome UX Report API" on the same Google Cloud project.
# Without it C-4.1 is NOT_TESTABLE / CWV_NO_API_KEY — a missing input, never a site defect.
GOOGLE_API_KEY=

# ── Anthropic ────────────────────────────────────────────────────────────────
# Enables the Section 6 rubric (entity clarity, content structure, answer extractability, and the
# content-currency check). Deterministic gates run with or without it; only the modelled sub-scores
# depend on it, and they always carry the MODELLED caveat.
ANTHROPIC_API_KEY=

# ── Cloro ────────────────────────────────────────────────────────────────────
# Stored but not read by any check. PRD v2.0 defines no check that consumes it, and no rule may be
# invented for a factor the PRD does not specify. If this is a SERP provider intended for the
# checklist's "Googlebot Access (using SERP)" item, that check still needs rules, conditions and a
# registered source before it can be scored.
CLORO_API_KEY=

# DataForSEO - used as a fetch transport, not a data source. It crawls from its own proxy pool,
# which is the point: an identified bot on a datacentre IP gets challenged. Basic auth; these are
# the login and password from https://app.dataforseo.com/api-access (not the API "key").
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
